<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:tools="http://schemas.android.com/tools"
  xmlns:app="http://schemas.android.com/apk/res-auto"
  android:textDirection="rtl"
  android:layoutDirection="rtl"
  android:gravity="center"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:id="@+id/linearLayout_azkar">
  <androidx.appcompat.widget.AppCompatImageView
      android:layout_width="match_parent"
      android:layout_height="match_parent"
      app:srcCompat="@drawable/azkar_background"
      android:scaleType="centerCrop"/>
  <at.markushi.ui.CircleButton
      android:visibility="gone"
      android:layout_marginTop="16dp"
      android:layout_marginEnd="16dp"
      android:padding="8dp"
      app:cb_pressedRingWidth="1dp"
      android:layout_marginStart="16dp"
      android:id="@+id/bt_azkar_exit"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      app:cb_color="#658668"
      android:src="@drawable/ic_close_black_24dp" />

  <LinearLayout
    android:layout_margin="32dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">



    <TextView
      android:gravity="center"
      android:textColor="#FFAA3F"
        android:fontFamily="@font/almarai"
      android:textSize="23sp"
        android:layout_marginTop="50dp"
      android:textStyle="bold"
        android:id="@+id/tv_azkar_start_your_day"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:text="ابدأ يومك بذكر الله" />

    <TextView
      android:gravity="center"
      android:textColor="#FFFFFF"
      android:textSize="30sp"
        android:id="@+id/tv_azkar_name"

        android:layout_marginTop="20dp"
      android:textStyle="bold"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:text="أذكار الصباح والمساء" />



    <Button
        android:id="@+id/bt_azkar_enter"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="32dp"
        android:layout_marginTop="300dp"
        android:layout_marginEnd="32dp"
        android:layout_marginBottom="40dp"
        android:background="@drawable/rounded_pop_up"
        android:text="@string/enter"
        android:textColor="#347D53"
        android:textSize="22sp"
        android:textStyle="bold" />
    <!--      />-->
  </LinearLayout>



</RelativeLayout>

